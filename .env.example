# =============================================================================
# KolabReport: variables d'environnement
# Copier ce fichier en `.env.local` (jamais commité) puis renseigner les valeurs.
# Les variables préfixées NEXT_PUBLIC_ sont exposées au navigateur : n'y mettez
# JAMAIS de secret.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# URL publique de l'application (sans slash final). Utilisée pour les liens
# d'authentification (confirmation d'e-mail, réinitialisation du mot de passe).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KolabReport
# Locale par défaut (seule locale supportée pour le MVP).
NEXT_PUBLIC_DEFAULT_LOCALE=fr
# development | staging | production
APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase: clés du projet (Dashboard > Project Settings > API)
# En local, `npx supabase start` affiche ces valeurs.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVEUR UNIQUEMENT, contourne la RLS. Ne jamais importer côté client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Identifiant du projet (utilisé par `supabase link` / `supabase gen types`).
SUPABASE_PROJECT_REF=your-project-ref

# -----------------------------------------------------------------------------
# Supabase: connexions Postgres directes (scripts, migrations, jobs)
# Pooler Supavisor (successeur de PgBouncer) en mode transaction, port 6543 :
# à utiliser pour toute connexion depuis du serverless (Vercel Functions).
# Connexion directe port 5432 : réservée aux migrations et outils d'admin.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Supabase Storage: livrables des experts
# -----------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET_DELIVERABLES=deliverables
# Taille max d'un livrable en octets (50 Mo). Doit rester <= à la limite du bucket.
MAX_UPLOAD_SIZE_BYTES=52428800
# Durée de validité des URL d'upload/téléchargement signées (secondes).
SIGNED_URL_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# E-mails de l'application (invitations)
# Les e-mails d'authentification passent par Supabase Auth, pas par ici.
# EMAIL_PROVIDER : brevo | resend | mailpit (local et tests e2e)
# Sans fournisseur, l'invitation est créée et le lien s'affiche pour être
# envoyé à la main.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=mailpit
EMAIL_FROM="KolabReport <noreply@kolabreport.local>"
BREVO_API_KEY=your-brevo-api-key
RESEND_API_KEY=your-resend-api-key
# Mailpit de la stack Supabase locale (`npx supabase start`).
MAILPIT_URL=http://127.0.0.1:54324

# -----------------------------------------------------------------------------
# IA: Vercel AI SDK (brouillons de section, Story KRB-16)
# AI_PROVIDER : anthropic | openai | mock
# "mock" répond un texte fixe, sans clé : tests de bout en bout et travail en
# local. Il est refusé quand APP_ENV ou VERCEL_ENV vaut production.
# -----------------------------------------------------------------------------
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
# Modèle plus rapide/économique pour les tâches courtes (résumés de livrables).
AI_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
# Les brouillons restent coupés tant que la suite d'évaluation n'est pas passée
# sur le modèle de l'environnement (voir evals/README.md).
AI_DRAFTS_ENABLED=false
# Valeurs par défaut quand un modèle de prompt ne fixe pas les siennes.
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.3
# Nombre max de générations IA par utilisateur et par heure.
AI_RATE_LIMIT_PER_HOUR=30
# Jetons par espace de travail et par mois civil (UTC), toutes générations comprises.
AI_MONTHLY_TOKEN_BUDGET=2000000
# Fenêtre de contexte du modèle et plafond d'un prompt, en jetons.
AI_CONTEXT_WINDOW_TOKENS=200000
AI_MAX_INPUT_TOKENS=60000
# Masque e-mails, téléphones, IBAN, n° de sécurité sociale et de carte avant l'envoi au modèle.
AI_REDACT_PII=true
# Prix en USD par million de jetons, pour l'estimation du coût. Vides : pas d'estimation.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_FAST_INPUT_PER_MTOK=
AI_PRICE_FAST_OUTPUT_PER_MTOK=

# -----------------------------------------------------------------------------
# PWA
# Mettre à "true" pour activer le service worker en développement (debug).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PWA_ENABLE_IN_DEV=false
