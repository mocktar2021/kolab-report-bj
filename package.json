{
  "name": "kolab-report-bj",
  "version": "0.1.0",
  "private": true,
  "description": "KolabReport, plateforme collaborative de rédaction de rapports d'experts assistée par IA (PWA, Next.js, Supabase).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run build:worker && next dev",
    "build": "npm run build:worker && next build && node scripts/check-pdf-fonts.mjs",
    "build:worker": "node scripts/build-parse-worker.mjs",
    "eval": "npm run eval:build --silent && node build/evals.mjs",
    "eval:build": "node scripts/build-evals.mjs",
    "eval:agreement": "npm run eval:build --silent && node build/evals.mjs agreement",
    "eval:template-writer": "npm run eval:build --silent && node build/evals.mjs template-writer",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.130",
    "@ai-sdk/openai": "^3.0.127",
    "@ai-sdk/provider": "^3.0.18",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.208.0",
    "@opentelemetry/instrumentation": "^0.208.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.57.4",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@vercel/otel": "^2.1.3",
    "ai": "^6.0.306",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "docx": "^9.8.1",
    "domhandler": "^6.0.1",
    "exceljs": "^4.4.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.13.0",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-to-markdown": "^2.2.0",
    "motion": "^13.5.1",
    "next": "^15.5.4",
    "next-intl": "^4.3.12",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "unified": "^11.0.5",
    "unpdf": "1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "puppeteer-core": "24.43.1",
    "supabase": "^2.45.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0",
    "next": {
      "postcss": "^8.5.23"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "sh scripts/check-prose.sh"
    ],
    "*.{json,css}": [
      "prettier --write"
    ],
    "*.{yml,yaml}": [
      "prettier --write",
      "sh scripts/check-prose.sh"
    ],
    "*.{md,sql,html,toml}": [
      "sh scripts/check-prose.sh"
    ]
  }
}
