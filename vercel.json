{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "git": {
    "deploymentEnabled": {
      "master": false,
      "production": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "17 5 * * *"
    }
  ]
}
