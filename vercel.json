{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "17 5 * * *"
    }
  ]
}
